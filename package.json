{
  "name": "fragrance-notes",
  "version": "1.4.0",
  "description": "A comprehensive collection of fragrance notes with high-quality images and metadata for perfume enthusiasts and developers.",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./images/*": "./assets/images/*",
    "./images-transparent/*": "./assets/images-transparent/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "index.d.ts"
  ],
  "scripts": {
    "test": "jest",
    "validate": "npm run validate:data",
    "validate:data": "node scripts/validate-data.js",
    "images:transparent": "node scripts/generate-transparent-images.js",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asifnawaz/fragrance-notes.git"
  },
  "keywords": [
    "fragrance",
    "perfume",
    "notes",
    "scent",
    "olfactory",
    "cologne",
    "fragrance-library"
  ],
  "author": "Asif Nawaz <iamasifnawaz@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "jest": "^30.2.0",
    "semantic-release": "^25.0.3",
    "sharp": "^0.34.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
